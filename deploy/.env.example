# ════════════════════════════════════════════════
#  Firmatek – plik konfiguracyjny
#  Skopiuj jako .env i uzupełnij wartości
# ════════════════════════════════════════════════

# ─── Baza danych ─────────────────────────────────
POSTGRES_PASSWORD=zmien_to_haslo_postgres

# ─── Redis ───────────────────────────────────────
REDIS_PASSWORD=zmien_to_haslo_redis

# ─── JWT ─────────────────────────────────────────
# Wygeneruj: openssl rand -hex 32
JWT_SECRET=zmien_na_bardzo_dlugi_losowy_sekret_min32znaki

# ─── Serwer ──────────────────────────────────────
SERVER_PORT=8080

# ─── Branding (widoczne w aplikacji) ─────────────
APP_NAME=Firmatek
APP_VERSION=1.0.0

# ─── Rejestracja ─────────────────────────────────
# true  = użytkownicy mogą sami zakładać konta lokalnie
# false = wyłączone (używaj gdy masz LDAP/AD)
ENABLE_REGISTRATION=true

# ─── Active Directory / LDAP ─────────────────────
# Ustaw LDAP_ENABLED=true by włączyć logowanie przez AD
LDAP_ENABLED=false
LDAP_URL=ldap://dc.firma.local:389
# lub ldaps://dc.firma.local:636 dla SSL
LDAP_DOMAIN=firma.local
LDAP_BASE_DN=DC=firma,DC=local
# Konto serwisowe do wyszukiwań (może być tylko do odczytu)
LDAP_BIND_USER=svc_firmatek@firma.local
LDAP_BIND_PASSWORD=haslo_konta_serwisowego
# Filtr wyszukiwania użytkownika (%s = wpisany login)
LDAP_USER_FILTER=(sAMAccountName=%s)

# ─── CI/CD powiadomienia ──────────────────────────
# Token do wysyłania powiadomień z pipeline'ów (curl/Python/GitLab CI/GitHub Actions)
# Zostaw puste by wyłączyć endpoint /api/notify
NOTIFY_TOKEN=zmien_na_losowy_token_cicd
