# Normalize line endings: store text as LF in the repo and check out LF on all
# platforms (overrides each developer's core.autocrlf). Keeps diffs clean and
# avoids CRLF sneaking into files that require LF (Dockerfiles, shell, YAML).
* text=auto eol=lf

# Windows-only scripts that genuinely need CRLF (none yet; future-proofing).
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets — never touch their bytes.
*.png   binary
*.ico   binary
*.icns  binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.tar.gz binary
