{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default Firmatek permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "notification:default",
    "dialog:allow-save",
    "fs:allow-open",
    "fs:allow-write",
    "fs:allow-remove"
  ]
}
