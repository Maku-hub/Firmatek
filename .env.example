# ════════════════════════════════════════════════
#  Firmatek – configuration file
#  Copy this to .env and fill in the values
# ════════════════════════════════════════════════

# ─── Database ────────────────────────────────────
POSTGRES_PASSWORD=change_me_postgres_password

# ─── Redis ───────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ─── JWT ─────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret_min_32_chars

# ─── Server ──────────────────────────────────────
SERVER_PORT=8080
# Comma-separated allowed origins for CORS and WebSocket. Leave empty to allow
# all (default). Set to your web origin(s) to lock down, e.g.:
# ALLOWED_ORIGINS=https://firmatek.firma.local
ALLOWED_ORIGINS=
# Reverse proxies whose X-Forwarded-For header is trusted (comma-separated IPs
# or CIDRs). Leave empty when clients connect directly. With the bundled Caddy
# proxy (--profile proxy) use the Docker network range, e.g. 172.16.0.0/12,
# otherwise every user is seen as the proxy's address and shares one rate limit.
TRUSTED_PROXIES=
# Hostname for the optional Caddy TLS proxy (docker compose --profile proxy up)
FIRMATEK_DOMAIN=firmatek.local

# ─── Branding (visible in the app) ───────────────
APP_NAME=Firmatek
APP_VERSION=1.0.0

# ─── Registration ────────────────────────────────
# true  = users can create local accounts themselves
# false = disabled
# Ignored when LDAP_ENABLED=true: then every login goes to the directory.
ENABLE_REGISTRATION=true

# ─── Active Directory / LDAP ─────────────────────
# Set LDAP_ENABLED=true to enable login via AD
LDAP_ENABLED=false
LDAP_URL=ldap://dc.firma.local:389
# or ldaps://dc.firma.local:636 for SSL
LDAP_DOMAIN=firma.local
LDAP_BASE_DN=DC=firma,DC=local
# Service account for lookups (may be read-only)
LDAP_BIND_USER=svc_firmatek@firma.local
LDAP_BIND_PASSWORD=change_me_service_account_password
# User search filter (%s = the entered login)
LDAP_USER_FILTER=(sAMAccountName=%s)
# TLS certificate verification. Leave false (verify) unless your AD uses a
# self-signed certificate, in which case set true. With ldap:// the server tries
# STARTTLS and, if it fails, falls back to a plain connection.
LDAP_TLS_SKIP_VERIFY=false

# ─── TURN relay (WebRTC P2P) ─────────────────────
# Optional. Only needed when peers are behind strict NAT and require a relay.
# Start coturn with: docker compose --profile turn up -d
# TURN_SECRET must match coturn's --static-auth-secret (openssl rand -hex 32).
# Leave TURN_SECRET empty to advertise STUN only (no relay).
TURN_SECRET=
TURN_REALM=firmatek.local
# Comma-separated TURN URLs advertised to clients:
# TURN_URLS=turn:firmatek.firma.local:3478
TURN_URLS=
# Credential lifetime in seconds
TURN_TTL=3600

# ─── CI/CD notifications ─────────────────────────
# Token for sending notifications from pipelines (curl/Python/GitLab CI/GitHub Actions)
# Leave empty to disable the /api/notify endpoint. Values shorter than 16
# characters or starting with "change" are treated as unset.
# Generate with: openssl rand -hex 24
NOTIFY_TOKEN=change_me_to_a_random_cicd_token
